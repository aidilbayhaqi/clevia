# Clevia repository text normalization.
* text=auto

*.py      text eol=lf
*.md      text eol=lf
*.toml    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.ini     text eol=lf
*.cfg     text eol=lf
*.sh      text eol=lf
*.ps1     text eol=lf

.gitignore     text eol=lf
.env.example   text eol=lf
Dockerfile     text eol=lf
Dockerfile.dev text eol=lf
Makefile       text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.zip   binary
*.pdf   binary
