APP_NAME=Clevia Beauty Clinic API
APP_VERSION=0.6.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://clevia:clevia@postgres:5432/clevia
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480

DEFAULT_CLINIC_SLUG=clevia

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MAX_AGENT_STEPS=6
AGENT_TRANSACTIONAL_TOOLS_ENABLED=false
KNOWLEDGE_EMBEDDINGS_ENABLED=false
KNOWLEDGE_CHUNK_MAX_CHARS=1200

CORS_ORIGINS=["http://localhost:3000"]
CACHE_TTL_CLINIC_SECONDS=900
CACHE_TTL_SERVICES_SECONDS=300
CACHE_TTL_STAFF_SECONDS=300
CACHE_TTL_AVAILABILITY_SECONDS=30
CACHE_TTL_KNOWLEDGE_SECONDS=120

FRONTEND_API_URL=http://localhost:8000/api/v1
FRONTEND_DEMO_MODE=false
FRONTEND_WHATSAPP_NUMBER=622155502026
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_API_KEY=

# CLEVIA_PATCH_P0_GEMINI_PROVIDER_V060 BEGIN
# Gemini provider (v0.6.0) - jangan taruh secret asli di file ini.
# LLM_PROVIDER tetap mengikuti runtime existing sampai wiring provider selesai diaudit.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048
# CLEVIA_PATCH_P0_GEMINI_PROVIDER_V060 END

# CLEVIA_PATCH_P0_LLM_PROVIDER_FACTORY_V062 BEGIN
# Pemilihan provider LLM canonical Clevia. Secret tetap berada di .env/secret manager.
LLM_PROVIDER=gemini
# CLEVIA_PATCH_P0_LLM_PROVIDER_FACTORY_V062 END
